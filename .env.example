# CRM Quality Inspector — environment configuration
# Copy this file to `.env` and fill in the values for your environment.
# NEVER commit `.env` to source control.

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://PG_USER_REDACTED:CHANGE_ME@127.0.0.1:5432/crm_quality_inspector

# Admin user (created automatically on first start)
ADMIN_USERNAME=admin
# Generate a strong password: e.g. `openssl rand -base64 24`
ADMIN_PASSWORD=CHANGE_ME

# Server bind address (default: 127.0.0.1:3000)
# Use 0.0.0.0:3000 to expose to a LAN
# SERVER_ADDR=0.0.0.0:3000
