# CRM Quality Inspector — environment configuration
# Copy this file to `.env` and fill in the values for your environment.
# NEVER commit `.env` to source control.

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://PG_USER_REDACTED:CHANGE_ME@127.0.0.1:5432/crm_quality_inspector

# Admin user (created automatically on first start; ignored if users exist)
ADMIN_USERNAME=admin
# Generate a strong password: e.g. `openssl rand -base64 24`
# REQUIRED. The server refuses to start if this is empty or shorter than 8 chars.
ADMIN_PASSWORD=set-a-strong-password-here

# Server bind address (default: 127.0.0.1:3000)
# Use 0.0.0.0:3000 to expose to a LAN
# SERVER_ADDR=0.0.0.0:3000

# ============ Docker compose only ============
# These are read by docker-compose.yml and passed to the postgres service.
# They are NOT read by the Rust app — set DATABASE_URL above for the app.
POSTGRES_USER=crm_quality
POSTGRES_PASSWORD=set-a-strong-pg-password
POSTGRES_DB=crm_quality_inspector
